# AssetAgent sidecar 环境变量样例
# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不要提交真实 Key。

# ---- 服务 ----
ASSETAGENT_HOST=127.0.0.1
ASSETAGENT_PORT=8756
# 数据目录（资产库 + 版本树 + 导出产物）。默认 <repo>/.data
ASSETAGENT_DATA_DIR=

# ---- Provider 路由 ----
# byok = 用下面自填的 Key 直连；relay = 走官方中转（Phase 2）
ASSETAGENT_ROUTE_MODE=byok
# 无 Key 时是否允许自动降级到 mock provider（开发用，生产应为 false）
ASSETAGENT_ALLOW_MOCK_FALLBACK=true

# ---- BYOK：自填 Key（永不上传，仅本机使用）----
MESHY_API_KEY=
TRIPO_API_KEY=
RODIN_API_KEY=

# ---- Provider 端点（以官方文档为准，W1 需对照校正）----
MESHY_BASE_URL=https://api.meshy.ai
TRIPO_BASE_URL=https://api.tripo3d.ai
RODIN_BASE_URL=https://api.hyper3d.com

# ---- 成本与预算 ----
# 单次生成预估成本（人民币），用于生成前预估与预算拦截
ASSETAGENT_COST_PER_GENERATION_CNY=2.5
# 月度预算上限（人民币），0 表示不限制
ASSETAGENT_MONTHLY_BUDGET_CNY=200

# ---- 后处理管线 ----
# Blender 可执行文件路径。留空则自动探测；探测不到则烘焙与转台渲染降级跳过
ASSETAGENT_BLENDER_BIN=
# 默认减面目标（三角面），可被规格预设覆盖
ASSETAGENT_DEFAULT_FACE_BUDGET=5000
